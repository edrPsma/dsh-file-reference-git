{
  "name": "dsh-file-reference-git",
  "version": "1.0.0",
  "description": "Scalable @file completion for DSH: indexes the whole workspace via `git ls-files`, so large repos (100k+ files) stay searchable and .gitignore is respected. Replaces the built-in local provider.",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./search": "./search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "search.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "icon.svg"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "file-reference",
    "at-mention",
    "gitignore",
    "codex",
    "claude"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
